# 示例；应用不会自动读取 .env。通过进程管理器或 Node --env-file 加载。
PORT=4310
DAILY_DATABASE_PATH=./data/daily-flow.sqlite
# 建立首位成员后启用可信 HTTPS 源地址，不带末尾斜线或子路径。
# DAILY_PUBLIC_URL=https://team.example.com
# 按实际 Codex 授权请求登记精确回调路径；不带端口时仅允许本机动态端口。
# DAILY_CODEX_REDIRECT_URIS=["http://127.0.0.1/callback/<实际连接标识>"]
DAILY_MCP_MEMBER_LIMIT=240
DAILY_MCP_GRANT_LIMIT=120
DAILY_MCP_MAX_BODY_BYTES=16777216
