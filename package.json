{
  "name": "daily-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run check:architecture && npm run typecheck && npm run build:server && vite build",
    "start": "node build/server/main.js",
    "typecheck": "tsc --noEmit",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test": "npm run build && npm run test:api && npm run test:ui",
    "test:api": "npm run build:server && tsx --test tests/*.test.ts",
    "test:ui": "npm run build:server && playwright test",
    "format": "prettier --write server src scripts tests docs *.json *.ts *.html *.md",
    "build:server": "node scripts/build-server.mjs",
    "test:upgrade": "node --import tsx scripts/verify-upgrade.mjs",
    "test:production": "node scripts/verify-production.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-express": "12.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
