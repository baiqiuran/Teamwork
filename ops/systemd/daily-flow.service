[Unit]
Description=Daily Flow team workspace
After=network.target

[Service]
Type=simple
User=daily-flow
Group=daily-flow
WorkingDirectory=/opt/daily-flow/managed-current
EnvironmentFile=/etc/daily-flow/daily-flow.env
# Snapshot and application processes must hold the same exclusive data lock.
ExecStart=/usr/bin/flock --nonblock /run/lock/daily-flow-data.lock /usr/local/bin/node build/server/main.js
KillMode=control-group
TimeoutStopSec=35
Restart=no
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/daily-flow /run/lock/daily-flow-data.lock

[Install]
WantedBy=multi-user.target
