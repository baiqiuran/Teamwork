[Unit]
Description=Reconcile Daily Flow ownership after host startup
After=network-online.target nginx.service
Wants=network-online.target
Requires=nginx.service

[Service]
Type=oneshot
UMask=0077
ExecStart=/usr/local/bin/node /opt/daily-flow/control/ops/reconcile.mjs --config /etc/daily-flow/deploy.json
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
